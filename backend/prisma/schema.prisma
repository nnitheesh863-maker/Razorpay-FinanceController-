datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  FINANCE_MANAGER
  FINANCE_ANALYST
  VIEWER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      Role     @default(VIEWER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id          String   @id @default(uuid())
  date        String   // ISO YYYY-MM-DD
  merchant    String
  category    String   @default("Needs review")
  amount      Float    // stored as positive magnitude
  type        String   // "expense" or "income"
  account     String   @default("Imported account")
  tags        String   @default("[]") // stored as a JSON array string
  receipt     Int      @default(0) // 0 = false, 1 = true
  source      String   // "manual", "csv", "document", "google-drive"
  fingerprint String   @unique // date|merchant|amount|account
  createdAt   String   // ISO timestamp
}

model Tag {
  name      String   @id
  createdAt String   // ISO timestamp
}

model Rule {
  id        String   @id @default(uuid())
  whenText  String
  thenText  String
  enabled   Int      @default(1) // 0 = disabled, 1 = enabled
  createdAt String   // ISO timestamp
}

model Setting {
  key       String   @id
  value     String   // JSON string or scalar
  updatedAt String   // ISO timestamp
}

model Document {
  id        String   @id @default(uuid())
  filename  String
  mimeType  String
  size      Int
  objectKey String   @unique // uploads/<uuid>-<safe-filename> or drive-inbox/<safe-file-id>-<safe-filename>
  status    String   // "queued", "stored", "review"
  source    String   // "upload", "google-drive"
  createdAt String   // ISO timestamp
}
