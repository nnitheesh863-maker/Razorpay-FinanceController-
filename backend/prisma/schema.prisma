datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  FINANCE_MANAGER
  FINANCE_ANALYST
  VIEWER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
  VOID
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum RunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
  CANCELLED
}

enum MatchStatus {
  MATCHED
  UNMATCHED
  PARTIAL_MATCH
  REVIEW_REQUIRED
  EXCEPTION
}

enum MatchType {
  EXACT
  REFERENCE
  AMOUNT
  DATE
  FUZZY
  MANUAL
  PARTIAL
  NONE
}

enum ExceptionSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ExceptionStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REOPENED
  IGNORED
  CLOSED
}

enum ExceptionType {
  AMOUNT_MISMATCH
  MISSING_RECORD
  DUPLICATE
  REFERENCE_MISMATCH
  DATE_MISMATCH
  CURRENCY_MISMATCH
  UNKNOWN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      Role     @default(VIEWER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id              String             @id @default(uuid())
  invoiceNumber   String             @unique
  referenceNumber String?
  customerName    String
  customerId      String?
  issueDate       DateTime
  dueDate         DateTime
  currency        String             @default("INR")
  subtotal        Float
  tax             Float
  discount        Float              @default(0)
  totalAmount     Float
  paidAmount      Float              @default(0)
  balanceDue      Float
  status          InvoiceStatus      @default(DRAFT)
  paymentStatus   PaymentStatus      @default(UNPAID)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  lineItems       InvoiceLineItem[]
  payments        Payment[]
  transactions    Transaction[]
}

model InvoiceLineItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Float
  tax         Float
  discount    Float    @default(0)
  lineTotal   Float
}

model Payment {
  id               String        @id @default(uuid())
  amount           Float
  currency         String        @default("INR")
  paymentMethod    String
  paymentGateway   String?       @default("RAZORPAY")
  gatewayPaymentId String?       @unique
  status           String
  customerName     String?
  customerEmail    String?
  paymentDate      DateTime
  invoiceId        String?
  invoice          Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  transactionId    String?       @unique
  transaction      Transaction?  @relation("PaymentToTransaction")
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  createdBy        String?
}

model Transaction {
  id            String         @id @default(uuid())
  amount        Float
  currency      String         @default("INR")
  status        String
  type          String
  reference     String?        @unique
  paymentMethod String?
  invoiceId     String?
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paymentId     String?        @unique
  payment       Payment?       @relation("PaymentToTransaction", fields: [paymentId], references: [id], onDelete: SetNull)
  settlementId  String?
  settlement    Settlement?    @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  createdBy     String?
}

model Settlement {
  id               String        @id @default(uuid())
  settlementDate   DateTime
  expectedAmount   Float
  settledAmount    Float
  fees             Float         @default(0)
  currency         String        @default("INR")
  gatewayReference String?       @unique
  status           String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  transactions     Transaction[]
}

model ReconciliationRun {
  id                   String                 @id @default(uuid())
  source               String
  target               String?
  startDate            DateTime?
  endDate              DateTime?
  recordsProcessed     Int                    @default(0)
  matchedRecords       Int                    @default(0)
  exceptionsFound      Int                    @default(0)
  unresolvedExceptions Int                    @default(0)
  matchRate            Float                  @default(0)
  durationMs           Int                    @default(0)
  status               RunStatus              @default(PENDING)
  reconciledAmount     Float                  @default(0)
  unmatchedAmount      Float                  @default(0)
  pendingAmount        Float                  @default(0)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  records              ReconciliationRecord[]
}

model ReconciliationRecord {
  id             String            @id @default(uuid())
  runId          String
  run            ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceRecordId String?
  sourceType     String?
  targetRecordId String?
  targetType     String?
  sourceAmount   Float
  targetAmount   Float
  difference     Float
  matchStatus    MatchStatus       @default(UNMATCHED)
  matchType      MatchType         @default(NONE)
  confidence     Float?
  reviewed       Boolean           @default(false)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  exceptions     Exception[]
}

model Exception {
  id             String               @id @default(uuid())
  description    String
  type           ExceptionType
  severity       ExceptionSeverity    @default(MEDIUM)
  status         ExceptionStatus      @default(OPEN)
  difference     Float?
  rootCause      String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  assignedToId   String?
  assignedToName String?
  recordId       String?
  record         ReconciliationRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)
  notes          ExceptionNote[]
  invoiceId      String?
  paymentId      String?
  transactionId  String?
  settlementId   String?
}

model ExceptionNote {
  id          String    @id @default(uuid())
  exceptionId String
  exception   Exception @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  authorId    String
  authorName  String
  content     String
  createdAt   DateTime  @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userEmail  String?
  action     String
  details    String
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model AIAnalysis {
  id          String   @id @default(uuid())
  query       String
  contextHash String
  response    String
  confidence  String
  model       String
  createdAt   DateTime @default(now())
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Document {
  id        String   @id @default(uuid())
  filename  String
  mimeType  String
  size      Int
  objectKey String   @unique
  status    String
  source    String
  createdAt DateTime @default(now())
}
